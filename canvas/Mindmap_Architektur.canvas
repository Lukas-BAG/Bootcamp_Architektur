{
	"nodes":[
		{"id":"center","type":"text","text":"# Softwarearchitektur & frühe Projektplanung\nBootcamp-Mindmap — 6 Module","x":-260,"y":-620,"width":520,"height":110,"color":"5"},

		{"id":"legende","type":"text","text":"**Legende:**\n🔴 Kernthema — muss sitzen\n🟢 Vertiefung — gutes Zusatzwissen\n🟣 Praxis/Reflexion — Fallstricke & Anwendung","x":320,"y":-620,"width":300,"height":110,"color":"6"},

