		{"id":"m0-2","type":"text","text":"User Stories & Akzeptanzkriterien","x":-1040,"y":-320,"width":380,"height":80,"color":"1"},
		{"id":"m0-3","type":"text","text":"MVP-Scoping: Muss vs. Kann vs. Später","x":-1460,"y":-210,"width":380,"height":80,"color":"1"},
		{"id":"m0-4","type":"text","text":"Architecture Decision Records (ADR)","x":-1040,"y":-210,"width":380,"height":80,"color":"4"},
