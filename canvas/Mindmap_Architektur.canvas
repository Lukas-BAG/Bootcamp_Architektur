		{"id":"g-m1","type":"group","x":-560,"y":-380,"width":880,"height":420,"color":"3","label":"Modul 1 · SOLID-Prinzipien"},
		{"id":"m1-1","type":"text","text":"S — Single Responsibility: eine Klasse, ein Änderungsgrund","x":-520,"y":-320,"width":800,"height":70,"color":"1"},
		{"id":"m1-2","type":"text","text":"O — Open/Closed: erweiterbar ohne bestehenden Code zu ändern","x":-520,"y":-235,"width":800,"height":70,"color":"1"},
		{"id":"m1-3","type":"text","text":"L — Liskov Substitution: Subtypen dürfen Verträge nicht brechen","x":-520,"y":-150,"width":800,"height":70,"color":"1"},
		{"id":"m1-4","type":"text","text":"I — Interface Segregation: kleine, passgenaue Schnittstellen","x":-520,"y":-65,"width":390,"height":70,"color":"4"},
		{"id":"m1-5","type":"text","text":"D — Dependency Inversion: gegen Abstraktionen, nicht Details","x":-110,"y":-65,"width":390,"height":70,"color":"1"},

		{"id":"g-m2","type":"group","x":420,"y":-380,"width":900,"height":420,"color":"6","label":"Modul 2 · Design Patterns"},
		{"id":"m2-1","type":"text","text":"Strategy — austauschbares Verhalten zur Laufzeit","x":460,"y":-320,"width":390,"height":75,"color":"1"},
		{"id":"m2-2","type":"text","text":"Factory Method — Objekterzeugung entkoppeln","x":870,"y":-320,"width":390,"height":75,"color":"1"},
		{"id":"m2-3","type":"text","text":"Observer — Ereignisse an mehrere Abonnenten verteilen","x":460,"y":-230,"width":390,"height":75,"color":"1"},
		{"id":"m2-4","type":"text","text":"Adapter — inkompatible Schnittstellen anpassen","x":870,"y":-230,"width":390,"height":75,"color":"4"},
		{"id":"m2-5","type":"text","text":"Decorator — Verhalten dynamisch erweitern statt vererben","x":460,"y":-140,"width":390,"height":75,"color":"4"},
		{"id":"m2-6","type":"text","text":"Singleton — Fallstricke: globaler Zustand, schwer testbar","x":870,"y":-140,"width":390,"height":75,"color":"6"},

		{"id":"g-m3","type":"group","x":-1500,"y":140,"width":880,"height":380,"color":"2","label":"Modul 3 · Architekturstile"},
		{"id":"m3-1","type":"text","text":"Schichtenarchitektur (Layered): Presentation / Domain / Data","x":-1460,"y":200,"width":800,"height":75,"color":"1"},
		{"id":"m3-2","type":"text","text":"MVC — Trennung von Daten, Logik und Darstellung","x":-1460,"y":290,"width":390,"height":75,"color":"1"},
		{"id":"m3-3","type":"text","text":"Clean / Hexagonal Architecture: Kern unabhängig von Frameworks","x":-1050,"y":290,"width":390,"height":75,"color":"1"},
		{"id":"m3-4","type":"text","text":"Monolith vs. Microservices — wann lohnt sich was?","x":-1460,"y":380,"width":800,"height":75,"color":"4"},

		{"id":"g-m4","type":"group","x":-560,"y":140,"width":880,"height":380,"color":"3","label":"Modul 4 · Modularität, Kopplung & Kohäsion"},
		{"id":"m4-1","type":"text","text":"Hohe Kohäsion innerhalb, lose Kopplung zwischen Modulen","x":-520,"y":200,"width":800,"height":75,"color":"1"},
		{"id":"m4-2","type":"text","text":"Abhängigkeitsrichtung: gegen stabile Abstraktionen zeigen","x":-520,"y":290,"width":390,"height":75,"color":"1"},
		{"id":"m4-3","type":"text","text":"Zyklische Abhängigkeiten erkennen & auflösen","x":-110,"y":290,"width":390,"height":75,"color":"4"},
		{"id":"m4-4","type":"text","text":"Module nach Fachlichkeit schneiden, nicht nach Technik","x":-520,"y":380,"width":800,"height":75,"color":"4"},

